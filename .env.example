# Copy this file to .env and fill in real values before running docker compose up.
# Never commit the real .env file.

DB_PASSWORD=choose-a-strong-password-here

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# Used to build the link inside password-reset emails, e.g. https://teastall.yourdomain.com
FRONTEND_URL=https://teastall.yourdomain.com

# SMTP settings for sending password-reset emails.
# Hostinger gives you SMTP credentials under hPanel > Emails, or use any
# transactional email provider (SendGrid, Mailgun, Brevo, etc).
# If left blank, reset links are only logged to the container's logs —
# fine for local testing, NOT fine for real users.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=no-reply@yourdomain.com
